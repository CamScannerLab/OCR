GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
# Empty uses qwen2.5-vl-7b-instruct when LM Studio has it loaded, else the first listed model
LM_STUDIO_VISION_MODEL=
# Optional: token budget, and reasoning effort sent to thinking models (none disables thinking; 'default' omits the field)
LM_STUDIO_MAX_TOKENS=900
LM_STUDIO_REASONING_EFFORT=none
